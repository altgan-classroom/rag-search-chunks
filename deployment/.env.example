# --- required
QDRANT_API_KEY=change-me-long-random
REDIS_PASSWORD=change-me-long-random
# API keys -> principals. Format  tenant|user|group1,group2[|admin]   (JSON for pydantic-settings)
ORCA_AUTH__API_KEYS={"dev-key":"default|dev||admin"}
ORCA_AUTH__CORS_ORIGINS=["http://localhost:3002","http://localhost:5173"]

# --- LLM (LiteLLM reads the standard provider variables; set whichever provider you use)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Offline demo without any key: deterministic extractive answers (NOT real generation quality)
ORCA_LLM__MOCK=false

# --- recipe
ORCA_PROFILE=advanced
